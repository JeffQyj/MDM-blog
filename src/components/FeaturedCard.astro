---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import { getCategoryUrl, getTagUrl } from "@utils/url-utils";

interface Props {
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	tags: string[];
	category: string | null;
	description: string;
	excerpt?: string;
	/** 序号（01/02/...），由调用方传入 */
	index: number;
	/** feature = 整宽特写，compact = 紧凑网格 */
	variant?: "feature" | "compact";
	class?: string;
	style?: string;
}

const {
	entry,
	title,
	url,
	published,
	tags,
	category,
	description,
	excerpt,
	index,
	variant = "compact",
	class: className,
	style,
} = Astro.props;

// 摘要：description 优先，fallback 到 remark 提取的 excerpt
const summary = description || excerpt || "";

// 仅显示前 3 个 tag，特写版完整展示
const visibleTags =
	variant === "feature" ? (tags ?? []).slice(0, 3) : (tags ?? []).slice(0, 2);

// 序号格式化：01、02、03 ...
const indexText = String(index).padStart(2, "0");

const publishDateText = published
	? `${published.getFullYear()}-${String(published.getMonth() + 1).padStart(2, "0")}-${String(published.getDate()).padStart(2, "0")}`
	: "";

// 预计阅读时长：从 excerpt 字数估算（粗略）
const readMinutes = Math.max(1, Math.round((excerpt?.length ?? 0) / 200));

const isFeature = variant === "feature";
---

<article
	class:list={[
		"featured-card group",
		isFeature ? "featured-card--feature" : "featured-card--compact",
		className,
	]}
	style={style}
>
    <!-- 巨号背景序号（feature 变体） / 顶部装饰条（compact 变体） -->
    {isFeature ? (
        <span class="featured-card__huge-number" aria-hidden="true">{indexText}</span>
    ) : (
        <span class="featured-card__top-bar" aria-hidden="true"></span>
    )}

    <!-- 顶部：序号小角标 + 分类小帽 -->
    <header class="featured-card__header">
        <span class="featured-card__index">{indexText}</span>
        {category && (
            <a
                href={getCategoryUrl(category)}
                class="featured-card__category"
                aria-label={`View all posts in ${category}`}
            >
                {category}
            </a>
        )}
    </header>

    <!-- 引言式描述（feature） / 普通描述（compact） -->
    {isFeature ? (
        <blockquote class="featured-card__quote">
            <span class="featured-card__quote-mark" aria-hidden="true">"</span>
            <p class="featured-card__summary">{summary}</p>
        </blockquote>
    ) : (
        <p class="featured-card__summary featured-card__summary--compact">
            {summary}
        </p>
    )}

    <!-- 标题 -->
    <a
        href={url}
        aria-label={title}
        class="featured-card__title"
    >
        {title}
    </a>

    <!-- 底部：元信息 + tag + 阅读按钮 -->
    <footer class="featured-card__footer">
        <div class="featured-card__meta">
            <!-- 日期 -->
            <span class="featured-card__meta-item">
                <Icon name="material-symbols:calendar-today-rounded" class="text-[0.95em]" />
                <time datetime={published?.toISOString?.()}>{publishDateText}</time>
            </span>
            <!-- 阅读时长 -->
            <span class="featured-card__meta-item">
                <Icon name="material-symbols:schedule-rounded" class="text-[0.95em]" />
                <span>约 {readMinutes} 分钟</span>
            </span>
            <!-- tag 斜杠分隔 -->
            {visibleTags.length > 0 && (
                <span class="featured-card__tags">
                    {visibleTags.map((tag, i) => (
                        <>
                            {i > 0 && <span class="featured-card__tag-sep">/</span>}
                            <a
                                href={getTagUrl(tag)}
                                class="featured-card__tag"
                                aria-label={`View all posts with the ${tag} tag`}
                            >
                                {tag.trim()}
                            </a>
                        </>
                    ))}
                </span>
            )}
        </div>

        <!-- 圆形 READ 按钮 -->
        <a
            href={url}
            aria-label={`阅读 ${title}`}
            class="featured-card__read-btn"
        >
            <span class="featured-card__read-text">READ</span>
            <Icon name="material-symbols:arrow-forward-rounded" class="text-[1.1em]" />
        </a>
    </footer>
</article>

<style>
    /* ============================================
       通用 token
       ============================================ */
    .featured-card {
        /* 衬线字体：杂志感的核心 */
        --serif:
            "Source Han Serif SC", "Noto Serif SC", "Songti SC",
            "STSong", "SimSun", "Georgia", serif;
        --display-num: var(--serif);
        --accent: var(--primary);
    }

    /* ============================================
       Feature 变体：整宽特写
       ============================================ */
    .featured-card--feature {
        position: relative;
        overflow: hidden;
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.25rem;
        padding: 2.5rem 2.5rem 2rem;
        border-radius: var(--radius-large);
        background:
            linear-gradient(
                135deg,
                oklch(0.97 0.025 var(--hue)) 0%,
                oklch(0.95 0.045 calc(var(--hue) + 40)) 100%
            );
        box-shadow:
            0 1px 0 0 oklch(0.95 0.03 var(--hue)) inset,
            0 1px 2px 0 rgb(0 0 0 / 0.04);
        transition:
            transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
            box-shadow 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    }

    :root.dark .featured-card--feature {
        background:
            linear-gradient(
                135deg,
                oklch(0.24 0.02 var(--hue)) 0%,
                oklch(0.28 0.04 calc(var(--hue) + 40)) 100%
            );
        box-shadow:
            0 1px 0 0 oklch(0.3 0.02 var(--hue)) inset,
            0 4px 16px -4px rgb(0 0 0 / 0.4);
    }

    .featured-card--feature:hover {
        transform: translateY(-4px);
        box-shadow:
            0 1px 0 0 oklch(0.95 0.03 var(--hue)) inset,
            0 12px 32px -8px oklch(0.5 0.1 var(--hue) / 0.25);
    }

    :root.dark .featured-card--feature:hover {
        box-shadow:
            0 1px 0 0 oklch(0.3 0.02 var(--hue)) inset,
            0 12px 32px -8px rgb(0 0 0 / 0.6);
    }

    /* 巨号背景序号 */
    .featured-card--feature .featured-card__huge-number {
        position: absolute;
        right: -1rem;
        bottom: -3.5rem;
        font-family: var(--display-num);
        font-weight: 900;
        font-size: 18rem;
        line-height: 0.85;
        color: var(--accent);
        opacity: 0.12;
        pointer-events: none;
        z-index: 0;
        font-feature-settings: "tnum" 1;
        transition: opacity 0.5s ease, transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .featured-card--feature:hover .featured-card__huge-number {
        opacity: 0.2;
        transform: translateX(-8px) scale(1.04);
    }

    /* ============================================
       Compact 变体：紧凑网格
       ============================================ */
    .featured-card--compact {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        padding: 1.75rem 1.5rem 1.25rem;
        border-radius: var(--radius-large);
        background: var(--card-bg);
        box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.04);
        transition:
            transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
            box-shadow 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .featured-card--compact:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 28px -8px rgb(0 0 0 / 0.12);
    }

    :root.dark .featured-card--compact:hover {
        box-shadow: 0 12px 28px -8px rgb(0 0 0 / 0.5);
    }

    /* compact 顶部装饰条 */
    .featured-card--compact .featured-card__top-bar {
        position: absolute;
        top: 0;
        left: 1.5rem;
        right: 1.5rem;
        height: 3px;
        border-radius: 0 0 4px 4px;
        background: linear-gradient(
            90deg,
            transparent 0%,
            var(--accent) 50%,
            transparent 100%
        );
        opacity: 0.5;
        transition: opacity 0.4s ease, height 0.4s ease;
    }

    .featured-card--compact:hover .featured-card__top-bar {
        opacity: 1;
        height: 4px;
    }

    /* ============================================
       共享元素
       ============================================ */
    .featured-card__header {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    /* 序号角标 */
    .featured-card__index {
        font-family: var(--display-num);
        font-weight: 900;
        font-feature-settings: "tnum" 1;
        letter-spacing: 0.02em;
    }

    .featured-card--feature .featured-card__index {
        font-size: 1.5rem;
        color: var(--accent);
    }

    .featured-card--compact .featured-card__index {
        font-size: 1.125rem;
        color: oklch(0.55 0.05 var(--hue));
    }

    :root.dark .featured-card--compact .featured-card__index {
        color: oklch(0.7 0.05 var(--hue));
    }

    /* 分类小帽 */
    .featured-card__category {
        display: inline-flex;
        align-items: center;
        padding: 0.25rem 0.625rem;
        font-size: 0.6875rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        border-radius: 999px;
        background: var(--btn-regular-bg);
        color: var(--btn-content);
        text-decoration: none;
        transition: background 0.3s ease;
    }

    .featured-card__category:hover {
        background: var(--btn-regular-bg-hover);
    }

    /* 描述 */
    .featured-card__summary {
        position: relative;
        z-index: 1;
        color: oklch(0.45 0.02 var(--hue));
        line-height: 1.65;
    }

    :root.dark .featured-card__summary {
        color: oklch(0.72 0.015 var(--hue));
    }

    .featured-card--feature .featured-card__summary {
        font-size: 1rem;
        padding-left: 0.5rem;
        border-left: 2px solid var(--accent);
        margin: 0;
    }

    .featured-card--compact .featured-card__summary--compact {
        font-size: 0.875rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* 引言大引号 */
    .featured-card__quote {
        position: relative;
        z-index: 1;
        margin: 0;
    }

    .featured-card__quote-mark {
        position: absolute;
        left: -0.5rem;
        top: -1.5rem;
        font-family: var(--serif);
        font-size: 4rem;
        line-height: 1;
        color: var(--accent);
        opacity: 0.25;
        font-weight: 900;
    }

    /* 标题 */
    .featured-card__title {
        position: relative;
        z-index: 1;
        display: block;
        color: oklch(0.25 0.02 var(--hue));
        text-decoration: none;
        transition: color 0.3s ease;
        font-family: var(--serif);
        font-weight: 800;
        line-height: 1.3;
    }

    :root.dark .featured-card__title {
        color: oklch(0.92 0.01 var(--hue));
    }

    .featured-card__title:hover {
        color: var(--accent);
    }

    .featured-card--feature .featured-card__title {
        font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem);
        padding-left: 1rem;
        border-left: 4px solid var(--accent);
    }

    .featured-card--compact .featured-card__title {
        font-size: 1.125rem;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* 底部 */
    .featured-card__footer {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-top: auto;
        padding-top: 0.75rem;
    }

    .featured-card--feature .featured-card__footer {
        border-top: 1px dashed oklch(0.5 0.02 var(--hue) / 0.25);
    }

    .featured-card--compact .featured-card__footer {
        border-top: 1px dashed oklch(0.5 0.02 var(--hue) / 0.2);
    }

    .featured-card__meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.875rem;
        font-size: 0.75rem;
        color: oklch(0.5 0.02 var(--hue));
    }

    :root.dark .featured-card__meta {
        color: oklch(0.65 0.015 var(--hue));
    }

    .featured-card__meta-item {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
    }

    .featured-card__tags {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        font-family: var(--serif);
        font-style: italic;
    }

    .featured-card__tag-sep {
        color: oklch(0.7 0.02 var(--hue));
    }

    .featured-card__tag {
        color: var(--accent);
        text-decoration: none;
        opacity: 0.85;
        transition: opacity 0.3s ease;
    }

    .featured-card__tag:hover {
        opacity: 1;
        text-decoration: underline;
        text-underline-offset: 3px;
    }

    /* 圆形 READ 按钮 */
    .featured-card__read-btn {
        position: relative;
        z-index: 1;
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.5rem 0.875rem;
        border-radius: 999px;
        background: var(--btn-regular-bg);
        color: var(--accent);
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-decoration: none;
        transition:
            background 0.35s ease,
            transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .featured-card__read-btn:hover {
        background: var(--btn-regular-bg-hover);
        transform: translateX(3px);
    }

    .featured-card--feature .featured-card__read-btn {
        padding: 0.625rem 1.125rem;
        font-size: 0.8125rem;
    }

    /* 入场动画 */
    @keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(16px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .featured-card {
        animation: fadeUp 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    /* 移动端适配 */
    @media (max-width: 640px) {
        .featured-card--feature {
            padding: 1.75rem 1.5rem 1.5rem;
        }
        .featured-card--feature .featured-card__huge-number {
            font-size: 11rem;
            bottom: -2.5rem;
        }
        .featured-card--feature .featured-card__title {
            font-size: 1.375rem;
        }
    }
</style>
