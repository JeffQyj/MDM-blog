---
import type { CollectionEntry } from "astro:content";
import path from "node:path";
import { Icon } from "astro-icon/components";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import { getDir } from "../utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	tags: string[];
	category: string | null;
	image: string;
	description: string;
	draft: boolean;
	style: string;
}
const {
	entry,
	title,
	url,
	published,
	tags,
	category,
	image,
	description,
	style,
} = Astro.props;
const className = Astro.props.class;

const hasCover = image !== undefined && image !== null && image !== "";

// 好书分享文章：封面图统一放在 src/assets/books/，需走 BookCard 同款 basePath
const isBookShare = (tags ?? []).includes("好书分享");
const coverBasePath = isBookShare
	? "assets/books/"
	: path.join("content/posts/", getDir(entry.id));

const { remarkPluginFrontmatter } = await entry.render();
---
<div
    class:list={["post-card onload-animation relative", className]}
    style={style}
>
    <a
        href={url}
        aria-label={title}
        class="post-card__link group block"
    >
        <!-- 顶层：纯渐变背景 + 大号水印数字（无 blur/无 filter/无 backdrop） -->
        <article class="post-card__surface relative overflow-hidden rounded-[var(--radius-large)]">
            <!-- 右上角大号序号（用 CSS 变量 + ::after 注入） -->
            <span class="post-card__index" aria-hidden="true"></span>

            <!-- 装饰性引号（纯 SVG/CSS，零运行时成本） -->
            <span class="post-card__quote" aria-hidden="true">
                <Icon name="material-symbols:format-quote-rounded" class="post-card__quote-icon"></Icon>
            </span>

            <!-- 内容 -->
            <div class="post-card__body relative z-10">
                <!-- 顶部：序号 + 分类胶囊 -->
                <div class="post-card__top flex items-center gap-3 mb-4">
                    <span class="post-card__num"></span>
                    <span class="post-card__cat">
                        {category || i18n(I18nKey.uncategorized)}
                    </span>
                </div>

                <!-- 描述（短引文） -->
                { (description || remarkPluginFrontmatter.excerpt) && (
                    <p class="post-card__excerpt mb-5">
                        { description || remarkPluginFrontmatter.excerpt }
                    </p>
                ) }

                <!-- 标题（左侧紫色 accent bar） -->
                <h3 class="post-card__title">
                    {title}
                </h3>

                <!-- 分隔虚线 -->
                <div class="post-card__divider"></div>

                <!-- 底部：日期/时长/标签 + READ -->
                <div class="post-card__foot">
                    <div class="post-card__meta">
                        <span class="post-card__meta-item">
                            <Icon name="material-symbols:calendar-today-outline-rounded" class="post-card__meta-icon"></Icon>
                            <span class="post-card__meta-text">{published.toISOString().slice(0, 10)}</span>
                        </span>
                        <span class="post-card__meta-sep">·</span>
                        <span class="post-card__meta-item">
                            <Icon name="material-symbols:schedule-outline-rounded" class="post-card__meta-icon"></Icon>
                            <span class="post-card__meta-text">{remarkPluginFrontmatter.minutes} {" " + i18n(remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}</span>
                        </span>
                        {tags && tags.length > 0 && tags.slice(0, 3).map((t) => (
                            <span class="post-card__tag">#{t.trim()}</span>
                        ))}
                    </div>

                    <span class="post-card__cta" aria-hidden="true">
                        <span class="post-card__cta-text">READ</span>
                        <Icon name="material-symbols:arrow-forward-rounded" class="post-card__cta-icon"></Icon>
                    </span>
                </div>
            </div>

            {hasCover && (
                <div class="post-card__cover">
                    <ImageWrapper
                        src={image}
                        basePath={coverBasePath}
                        alt="Cover Image of the Post"
                        class="post-card__cover-img"
                    ></ImageWrapper>
                </div>
            )}
        </article>
    </a>
</div>

<style>
    /* ===========================================================
       主页文章卡片 —— 干净、零性能负担的设计稿
       - 不使用 backdrop-filter / filter: blur / will-change
       - 不使用 box-shadow 大面积投影，hover 仅做轻微 transform
       - 全部用纯静态渐变与 CSS 变量，便于主题切换
       =========================================================== */

    .post-card {
        counter-increment: post-index;
    }

    .post-card__link {
        text-decoration: none;
        color: inherit;
    }

    /* ===== 表面：极淡渐变（白色为主，仅留一点主色温度） ================= */
    .post-card__surface {
        background:
            linear-gradient(
                135deg,
                #fcfcfd 0%,
                #f9f8fc 40%,
                #f6f4fa 70%,
                #f3f0f8 100%
            );
        border: 1px solid oklch(from var(--primary) l c h / 0.12);
        transition:
            transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
            box-shadow 0.45s cubic-bezier(0.22, 1, 0.36, 1);
        will-change: transform;
    }
    :root.dark .post-card__surface {
        background:
            linear-gradient(
                135deg,
                oklch(0.21 0.025 var(--hue)) 0%,
                oklch(0.19 0.03 calc(var(--hue) + 20)) 60%,
                oklch(0.17 0.03 calc(var(--hue) + 40)) 100%
            );
        border-color: oklch(from var(--primary) l c h / 0.18);
    }

    /* 悬停：仅上浮 + 极轻投影（GPU 友好的 transform） */
    .post-card__link:hover .post-card__surface,
    .post-card__link:active .post-card__surface {
        transform: translateY(-2px);
        box-shadow: 0 14px 32px -16px oklch(0.5 0.1 var(--hue) / 0.25);
    }
    :root.dark .post-card__link:hover .post-card__surface,
    :root.dark .post-card__link:active .post-card__surface {
        box-shadow: 0 14px 32px -16px oklch(0 0 0 / 0.6);
    }

    /* ===== 右上角大号水印数字（绝对定位，零渲染开销） ============= */
    .post-card__index {
        position: absolute;
        top: -1rem;
        right: 1.25rem;
        font-family: "Georgia", "Times New Roman", "Songti SC", serif;
        font-weight: 700;
        font-size: 8rem;
        line-height: 1;
        letter-spacing: -0.04em;
        color: oklch(from var(--primary) l c h / 0.08);
        pointer-events: none;
        user-select: none;
        z-index: 0;
    }
    .post-card__index::after {
        content: counter(post-index, decimal-leading-zero);
    }
    :root.dark .post-card__index {
        color: oklch(from var(--primary) l c h / 0.1);
    }

    /* 移动端缩小水印 */
    @media (max-width: 768px) {
        .post-card__index {
            font-size: 5.5rem;
            top: -0.5rem;
            right: 0.75rem;
        }
    }

    /* ===== 装饰性引号（粉色，纯 SVG icon） ========================== */
    .post-card__quote {
        position: absolute;
        top: 1rem;
        left: 1.25rem;
        z-index: 1;
        opacity: 0.85;
    }
    :root.dark .post-card__quote {
        opacity: 0.6;
    }
    .post-card__quote-icon {
        font-size: 1.75rem;
        color: oklch(from var(--primary) calc(l + 0.05) calc(c + 0.05) h / 0.55);
    }

    /* ===== 内容容器 ================================================= */
    .post-card__body {
        padding: 1.75rem 1.5rem 1.25rem 1.5rem;
        position: relative;
        z-index: 2;
    }
    @media (min-width: 768px) {
        .post-card__body {
            padding: 2rem 2.25rem 1.5rem 2.25rem;
        }
    }

    /* ===== 顶部：小序号 + 分类胶囊 ================================== */
    .post-card__top {
        position: relative;
        z-index: 3;
    }
    .post-card__num {
        font-family: "Georgia", "Times New Roman", serif;
        font-weight: 700;
        font-size: 1.05rem;
        color: oklch(from var(--primary) calc(l - 0.05) calc(c + 0.02) h);
        letter-spacing: 0.04em;
    }
    .post-card__num::after {
        content: counter(post-index, decimal-leading-zero);
    }
    :root.dark .post-card__num {
        color: oklch(from var(--primary) calc(l + 0.12) calc(c + 0.02) h);
    }

    .post-card__cat {
        display: inline-flex;
        align-items: center;
        height: 1.5rem;
        padding: 0 0.625rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 600;
        background-color: oklch(from var(--primary) l c h / 0.08);
        color: oklch(from var(--primary) calc(l - 0.05) calc(c + 0.02) h);
        border: 1px solid oklch(from var(--primary) l c h / 0.18);
        white-space: nowrap;
    }
    :root.dark .post-card__cat {
        background-color: oklch(from var(--primary) l c h / 0.18);
        color: oklch(0.92 0.04 var(--hue));
        border-color: oklch(from var(--primary) l c h / 0.3);
    }

    /* ===== 描述（短引文） =========================================== */
    .post-card__excerpt {
        position: relative;
        z-index: 3;
        font-size: 0.95rem;
        line-height: 1.6;
        color: oklch(0.35 0.02 var(--hue) / 0.7);
        font-style: italic;
        padding-left: 0.75rem;
        border-left: 2px solid oklch(from var(--primary) l c h / 0.35);
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    :root.dark .post-card__excerpt {
        color: oklch(0.85 0.015 var(--hue) / 0.75);
        border-left-color: oklch(from var(--primary) l c h / 0.5);
    }

    /* ===== 标题（左侧紫色 accent bar） ============================== */
    .post-card__title {
        position: relative;
        z-index: 3;
        font-size: 1.5rem;
        line-height: 1.4;
        font-weight: 700;
        color: oklch(0.22 0.04 var(--hue));
        padding-left: 0.875rem;
        margin: 0 0 1rem 0;
    }
    .post-card__title::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.55rem;
        bottom: 0.55rem;
        width: 3px;
        border-radius: 2px;
        background: linear-gradient(
            180deg,
            oklch(from var(--primary) l c h / 0.95),
            oklch(from var(--primary) calc(l - 0.1) c calc(h + 30) / 0.6)
        );
    }
    :root.dark .post-card__title {
        color: oklch(0.95 0.02 var(--hue));
    }
    @media (min-width: 768px) {
        .post-card__title {
            font-size: 1.75rem;
        }
    }

    /* ===== 分隔虚线 ================================================= */
    .post-card__divider {
        height: 1px;
        margin: 0 0 0.875rem 0;
        background-image: linear-gradient(
            to right,
            oklch(0.5 0.02 var(--hue) / 0.35) 50%,
            transparent 0%
        );
        background-size: 8px 1px;
        background-repeat: repeat-x;
    }
    :root.dark .post-card__divider {
        background-image: linear-gradient(
            to right,
            oklch(0.8 0.02 var(--hue) / 0.25) 50%,
            transparent 0%
        );
    }

    /* ===== 底部：元信息 + READ 按钮 ================================= */
    .post-card__foot {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .post-card__meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem 0.75rem;
        font-size: 0.8125rem;
        color: oklch(0.4 0.02 var(--hue) / 0.7);
    }
    :root.dark .post-card__meta {
        color: oklch(0.78 0.015 var(--hue) / 0.8);
    }
    .post-card__meta-item {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
    }
    .post-card__meta-icon {
        font-size: 0.95rem;
        opacity: 0.75;
    }
    .post-card__meta-sep {
        opacity: 0.4;
    }
    .post-card__tag {
        color: oklch(from var(--primary) calc(l - 0.1) calc(c + 0.05) h);
        font-weight: 500;
    }
    :root.dark .post-card__tag {
        color: oklch(from var(--primary) calc(l + 0.15) c h);
    }

    /* READ 按钮（无背景投影，仅靠边框 + 文字） */
    .post-card__cta {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        height: 1.85rem;
        padding: 0 0.75rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        color: oklch(from var(--primary) calc(l - 0.05) calc(c + 0.02) h);
        background-color: oklch(1 0 0 / 0.6);
        border: 1px solid oklch(from var(--primary) l c h / 0.25);
        transition:
            background-color 0.3s ease,
            border-color 0.3s ease,
            transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    }
    :root.dark .post-card__cta {
        color: oklch(0.95 0.02 var(--hue));
        background-color: oklch(from var(--primary) l c h / 0.18);
        border-color: oklch(from var(--primary) l c h / 0.35);
    }
    .post-card__link:hover .post-card__cta {
        background-color: oklch(from var(--primary) l c h / 0.12);
        border-color: oklch(from var(--primary) l c h / 0.4);
        transform: translateX(2px);
    }
    .post-card__cta-icon {
        font-size: 1rem;
    }

    /* ===== 封面图（可选，叠在右上角） =============================== */
    .post-card__cover {
        position: absolute;
        top: 0.75rem;
        right: 0.75rem;
        width: 90px;
        height: 90px;
        border-radius: 0.75rem;
        overflow: hidden;
        z-index: 1;
        opacity: 0.55;
        transition: opacity 0.4s ease;
    }
    .post-card__link:hover .post-card__cover {
        opacity: 0.85;
    }
    .post-card__cover-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    @media (min-width: 768px) {
        .post-card__cover {
            width: 110px;
            height: 110px;
        }
    }

    /* 移动端 :active 反馈（触屏无 hover） */
    @media (hover: none) {
        .post-card__link:active .post-card__surface {
            transform: translateY(-1px);
        }
    }
</style>
