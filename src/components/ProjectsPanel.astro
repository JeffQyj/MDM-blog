---
import type { CollectionEntry } from "astro:content";
import ProjectCard from "./ProjectCard.astro";
import ProjectsFilter from "./ProjectsFilter.svelte";

interface Props {
	posts: CollectionEntry<"posts">[];
}

const { posts } = Astro.props;

// 1) 预渲染所有 entry，拿到 remarkPluginFrontmatter（excerpt + minutes）
const renderedPosts = await Promise.all(
	posts.map(async (entry) => {
		const { remarkPluginFrontmatter } = await entry.render();
		return { entry, remarkPluginFrontmatter };
	}),
);

// 2) 派生统计（仅保留 Hero 数据条所需的三项）
const totalCount = renderedPosts.length;
const independentCount = renderedPosts.filter(
	(p) => p.entry.data.category === "独立项目",
).length;
const secondaryCount = renderedPosts.filter(
	(p) => p.entry.data.category === "二次开发",
).length;
---

<div class="projects-page">
	<!-- ============================================
	     Hero 英雄区（精简版：标题 + 副标题 + 3 项数据）
	     ============================================ -->
	<section
		class="projects-hero"
		style="animation-delay: calc(var(--content-delay) + 0ms);"
	>
		<!-- 栅格背景层 -->
		<div class="projects-hero__grid" aria-hidden="true"></div>
		<!-- 四角 ┌ ┐ └ ┘ 装饰 -->
		<span class="projects-hero__corner projects-hero__corner--tl" aria-hidden="true"></span>
		<span class="projects-hero__corner projects-hero__corner--tr" aria-hidden="true"></span>
		<span class="projects-hero__corner projects-hero__corner--bl" aria-hidden="true"></span>
		<span class="projects-hero__corner projects-hero__corner--br" aria-hidden="true"></span>

		<div class="projects-hero__inner">
			<!-- 主标题 -->
			<h1 class="projects-hero__title">
				<span class="projects-hero__title-en">Projects</span>
				<span class="projects-hero__title-zh">项　目</span>
			</h1>

			<!-- 副标题 -->
			<p class="projects-hero__subtitle">
				独立项目 · 二次开发　<span class="projects-hero__subtitle-sep">|</span>　共 {totalCount} 件
			</p>

			<!-- 关键数据条（3 项） -->
			<div class="projects-hero__specs">
				<div class="projects-hero__spec">
					<span class="projects-hero__spec-label">TOTAL</span>
					<span class="projects-hero__spec-value">{totalCount}</span>
				</div>
				<span class="projects-hero__spec-sep" aria-hidden="true">│</span>
				<div class="projects-hero__spec">
					<span class="projects-hero__spec-label">独立项目</span>
					<span class="projects-hero__spec-value">{independentCount}</span>
				</div>
				<span class="projects-hero__spec-sep" aria-hidden="true">│</span>
				<div class="projects-hero__spec">
					<span class="projects-hero__spec-label">二次开发</span>
					<span class="projects-hero__spec-value">{secondaryCount}</span>
				</div>
			</div>
		</div>
	</section>

	<!-- ============================================
	     筛选条
	     ============================================ -->
	<ProjectsFilter
		client:only="svelte"
		independentCount={independentCount}
		secondaryCount={secondaryCount}
		totalCount={totalCount}
	/>

	<!-- ============================================
	     空状态
	     ============================================ -->
	{renderedPosts.length === 0 && (
		<div class="projects-empty">
			<p class="projects-empty__text">
				暂无项目收录，去给想要展示的文章设置
				<code>category: 独立项目</code>
				或
				<code>category: 二次开发</code>
				吧。
			</p>
		</div>
	)}

	<!-- ============================================
	     项目卡片网格（限定 2 列）
	     ============================================ -->
	{renderedPosts.length > 0 && (
		<section
			class="projects-grid"
			aria-label="项目列表"
		>
			{renderedPosts.map(({ entry }, i) => {
				const techStack = (entry.data.tags ?? []).slice(0, 4);
				return (
					<ProjectCard
						entry={entry}
						techStack={techStack}
						index={i + 1}
						style={`animation-delay: calc(var(--content-delay) + ${(i + 1) * 60}ms);`}
					/>
				);
			})}
		</section>
	)}
</div>

<style>
	/* ============================================
	   Tokens
	   ============================================ */
	.projects-page {
		--mono:
			"JetBrains Mono Variable", ui-monospace, SFMono-Regular, Menlo, Monaco,
			Consolas, "Liberation Mono", "Courier New", monospace;
		--display: "Syne", "Noto Serif SC", "Source Han Serif SC", serif;
		--accent: var(--primary);
		--blueprint-line: oklch(0.55 0.02 var(--hue) / 0.18);

		display: flex;
		flex-direction: column;
		gap: 1.75rem;
	}

	/* ============================================
	   Hero
	   ============================================ */
	.projects-hero {
		position: relative;
		overflow: hidden;
		border-radius: var(--radius-large);
		padding: 4rem 2.5rem 3rem;
		background:
			linear-gradient(
				135deg,
				oklch(0.97 0.015 var(--hue)) 0%,
				oklch(0.94 0.03 calc(var(--hue) + 30)) 60%,
				oklch(0.96 0.045 calc(var(--hue) + 60)) 100%
			);
		box-shadow:
			inset 0 1px 0 0 oklch(0.99 0.01 var(--hue)),
			0 1px 2px 0 rgb(0 0 0 / 0.03);
		animation: projectsHeroIn 0.8s cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	:root.dark .projects-hero {
		background:
			linear-gradient(
				135deg,
				oklch(0.22 0.018 var(--hue)) 0%,
				oklch(0.26 0.035 calc(var(--hue) + 30)) 60%,
				oklch(0.30 0.05 calc(var(--hue) + 60)) 100%
			);
		box-shadow:
			inset 0 1px 0 0 oklch(0.32 0.02 var(--hue)),
			0 4px 20px -4px rgb(0 0 0 / 0.4);
	}

	@keyframes projectsHeroIn {
		from { opacity: 0; transform: translateY(-8px); }
		to { opacity: 1; transform: translateY(0); }
	}

	/* 栅格背景层（双层叠加：24px 细 + 120px 粗） */
	.projects-hero__grid {
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(var(--blueprint-line) 1px, transparent 1px),
			linear-gradient(90deg, var(--blueprint-line) 1px, transparent 1px),
			linear-gradient(oklch(0.5 0.02 var(--hue) / 0.08) 1px, transparent 1px),
			linear-gradient(90deg, oklch(0.5 0.02 var(--hue) / 0.08) 1px, transparent 1px);
		background-size:
			24px 24px,
			24px 24px,
			120px 120px,
			120px 120px;
		background-position: -1px -1px;
		pointer-events: none;
		opacity: 0.85;
	}

	/* 四角 ┌ ┐ └ ┘ 装饰 */
	.projects-hero__corner {
		position: absolute;
		width: 28px;
		height: 28px;
		pointer-events: none;
	}
	.projects-hero__corner::before,
	.projects-hero__corner::after {
		content: "";
		position: absolute;
		background: var(--accent);
	}
	.projects-hero__corner--tl { top: 16px; left: 16px; }
	.projects-hero__corner--tl::before { top: 0; left: 0; width: 100%; height: 2px; }
	.projects-hero__corner--tl::after { top: 0; left: 0; width: 2px; height: 100%; }
	.projects-hero__corner--tr { top: 16px; right: 16px; }
	.projects-hero__corner--tr::before { top: 0; right: 0; width: 100%; height: 2px; }
	.projects-hero__corner--tr::after { top: 0; right: 0; width: 2px; height: 100%; }
	.projects-hero__corner--bl { bottom: 16px; left: 16px; }
	.projects-hero__corner--bl::before { bottom: 0; left: 0; width: 100%; height: 2px; }
	.projects-hero__corner--bl::after { bottom: 0; left: 0; width: 2px; height: 100%; }
	.projects-hero__corner--br { bottom: 16px; right: 16px; }
	.projects-hero__corner--br::before { bottom: 0; right: 0; width: 100%; height: 2px; }
	.projects-hero__corner--br::after { bottom: 0; right: 0; width: 2px; height: 100%; }

	.projects-hero__inner {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.5rem;
		text-align: center;
	}

	/* 主标题 */
	.projects-hero__title {
		margin: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		line-height: 1;
	}

	.projects-hero__title-en {
		font-family: var(--display);
		font-size: 1rem;
		font-style: italic;
		font-weight: 600;
		letter-spacing: 0.32em;
		text-transform: uppercase;
		color: var(--accent);
		opacity: 0.75;
	}

	.projects-hero__title-zh {
		font-family: var(--display);
		font-size: clamp(2.5rem, 1.2rem + 5vw, 4.5rem);
		font-weight: 800;
		letter-spacing: 0.12em;
		background: linear-gradient(
			180deg,
			oklch(0.22 0.04 var(--hue)) 0%,
			oklch(0.45 0.1 var(--hue)) 100%
		);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	:root.dark .projects-hero__title-zh {
		background: linear-gradient(
			180deg,
			oklch(0.95 0.02 var(--hue)) 0%,
			oklch(0.7 0.1 var(--hue)) 100%
		);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	/* 副标题 */
	.projects-hero__subtitle {
		margin: 0;
		font-family: var(--mono);
		font-size: 0.8125rem;
		color: oklch(0.5 0.02 var(--hue));
		letter-spacing: 0.05em;
	}

	:root.dark .projects-hero__subtitle {
		color: oklch(0.7 0.015 var(--hue));
	}

	.projects-hero__subtitle-sep {
		opacity: 0.4;
		margin: 0 0.25rem;
	}

	/* 数据条（3 项） */
	.projects-hero__specs {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.625rem 0.875rem;
		margin-top: 1rem;
		padding: 1rem 1.5rem;
		border-top: 1px dashed oklch(0.5 0.02 var(--hue) / 0.3);
		border-bottom: 1px dashed oklch(0.5 0.02 var(--hue) / 0.3);
		font-family: var(--mono);
	}

	.projects-hero__spec {
		display: inline-flex;
		align-items: baseline;
		gap: 0.4375rem;
	}

	.projects-hero__spec-label {
		font-size: 0.625rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		color: oklch(0.55 0.02 var(--hue));
		opacity: 0.75;
	}

	:root.dark .projects-hero__spec-label {
		color: oklch(0.7 0.02 var(--hue));
	}

	.projects-hero__spec-value {
		font-size: 1.0625rem;
		font-weight: 800;
		color: oklch(0.3 0.04 var(--hue));
		font-feature-settings: "tnum" 1;
		letter-spacing: 0.04em;
	}

	:root.dark .projects-hero__spec-value {
		color: oklch(0.88 0.02 var(--hue));
	}

	.projects-hero__spec-sep {
		color: oklch(0.55 0.02 var(--hue));
		opacity: 0.3;
	}

	/* ============================================
	   空状态
	   ============================================ */
	.projects-empty {
		text-align: center;
		padding: 4rem 1rem;
		color: oklch(0.55 0.02 var(--hue));
		font-size: 0.95rem;
	}

	:root.dark .projects-empty {
		color: oklch(0.7 0.015 var(--hue));
	}

	.projects-empty__text code {
		font-family: var(--mono);
		background: var(--btn-regular-bg);
		padding: 0.1rem 0.4rem;
		border-radius: 4px;
		color: var(--accent);
		font-size: 0.85em;
	}

	/* ============================================
	   网格（限定 2 列）
	   ============================================ */
	.projects-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
	}

	@media (min-width: 768px) {
		.projects-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	/* ============================================
	   移动端
	   ============================================ */
	@media (max-width: 768px) {
		.projects-hero {
			padding: 2.5rem 1.25rem 2rem;
		}
		.projects-hero__corner {
			width: 20px;
			height: 20px;
		}
		.projects-hero__specs {
			gap: 0.375rem 0.625rem;
		}
		.projects-hero__spec-value {
			font-size: 0.9375rem;
		}
	}
</style>
