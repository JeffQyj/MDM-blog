---
import type { CollectionEntry } from "astro:content";
import ProjectCard from "./ProjectCard.astro";
import ProjectsFilter from "./ProjectsFilter.svelte";

interface Props {
	posts: CollectionEntry<"posts">[];
}

const { posts } = Astro.props;

// 1) 预渲染所有 entry，拿到 remarkPluginFrontmatter（excerpt + minutes）
const renderedPosts = await Promise.all(
	posts.map(async (entry) => {
		const { remarkPluginFrontmatter } = await entry.render();
		return { entry, remarkPluginFrontmatter };
	}),
);

// 2) 派生统计（仅保留 Hero 数据条所需的三项）
const totalCount = renderedPosts.length;
const independentCount = renderedPosts.filter(
	(p) => p.entry.data.category === "独立项目",
).length;
const secondaryCount = renderedPosts.filter(
	(p) => p.entry.data.category === "二次开发",
).length;
---

<div class="projects-page">
	<!-- ============================================
	     Hero 英雄区（精简版：标题 + 副标题 + 3 项数据 + 铅笔点缀 + 金色描边）
	     ============================================ -->
	<section
		class="projects-hero"
		style="animation-delay: calc(var(--content-delay) + 0ms);"
	>
		<!-- 栅格背景层 -->
		<div class="projects-hero__grid" aria-hidden="true"></div>

		<!-- 装饰：手绘铅笔（左上角，金色描边） -->
		<svg
			class="projects-hero__pencil projects-hero__pencil--tl"
			viewBox="0 0 64 64"
			fill="none"
			stroke="currentColor"
			stroke-width="1.6"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<!-- 笔尖三角 -->
			<path d="M6 58 L22 42" />
			<!-- 笔尖分隔线 -->
			<path d="M16 48 L22 42 L28 48" />
			<!-- 笔杆 -->
			<path d="M22 42 L46 18" />
			<path d="M28 48 L52 24" />
			<!-- 笔尾橡皮/金属箍 -->
			<path d="M46 18 L52 24 L58 18 L52 12 Z" />
			<path d="M52 12 L58 18" />
		</svg>

		<!-- 装饰：手绘铅笔（右下角，镜像旋转，金色描边） -->
		<svg
			class="projects-hero__pencil projects-hero__pencil--br"
			viewBox="0 0 64 64"
			fill="none"
			stroke="currentColor"
			stroke-width="1.6"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<path d="M6 58 L22 42" />
			<path d="M16 48 L22 42 L28 48" />
			<path d="M22 42 L46 18" />
			<path d="M28 48 L52 24" />
			<path d="M46 18 L52 24 L58 18 L52 12 Z" />
			<path d="M52 12 L58 18" />
		</svg>

		<!-- 金色 ✦ 星点点缀 -->
		<span class="projects-hero__spark projects-hero__spark--1" aria-hidden="true">✦</span>
		<span class="projects-hero__spark projects-hero__spark--2" aria-hidden="true">✦</span>
		<span class="projects-hero__spark projects-hero__spark--3" aria-hidden="true">✦</span>

		<!-- 四角 ┌ ┐ └ ┘ 装饰 -->
		<span class="projects-hero__corner projects-hero__corner--tl" aria-hidden="true"></span>
		<span class="projects-hero__corner projects-hero__corner--tr" aria-hidden="true"></span>
		<span class="projects-hero__corner projects-hero__corner--bl" aria-hidden="true"></span>
		<span class="projects-hero__corner projects-hero__corner--br" aria-hidden="true"></span>

		<div class="projects-hero__inner">
			<!-- 顶部小帽（手绘双线 + 文本） -->
			<div class="projects-hero__eyebrow">
				<span class="projects-hero__rule"></span>
				<span class="projects-hero__eyebrow-text">PORTFOLIO · 作品集</span>
				<span class="projects-hero__rule"></span>
			</div>

			<!-- 主标题 -->
			<h1 class="projects-hero__title">
				<span class="projects-hero__title-en">Projects</span>
				<span class="projects-hero__title-zh">项　目</span>
			</h1>

			<!-- 手绘金色下划线（铅笔勾线笔触） -->
			<svg
				class="projects-hero__underline"
				viewBox="0 0 220 14"
				fill="none"
				aria-hidden="true"
			>
				<path
					d="M4 9 Q 50 3, 100 7 T 216 6"
					stroke="currentColor"
					stroke-width="1.8"
					stroke-linecap="round"
				/>
			</svg>

			<!-- 关键数据条（3 项，数值采用金色渐变） -->
			<div class="projects-hero__specs">
				<div class="projects-hero__spec">
					<span class="projects-hero__spec-label">TOTAL</span>
					<span class="projects-hero__spec-value">{totalCount}</span>
				</div>
				<span class="projects-hero__spec-sep" aria-hidden="true">│</span>
				<div class="projects-hero__spec">
					<span class="projects-hero__spec-label">独立项目</span>
					<span class="projects-hero__spec-value">{independentCount}</span>
				</div>
				<span class="projects-hero__spec-sep" aria-hidden="true">│</span>
				<div class="projects-hero__spec">
					<span class="projects-hero__spec-label">二次开发</span>
					<span class="projects-hero__spec-value">{secondaryCount}</span>
				</div>
			</div>
		</div>
	</section>

	<!-- ============================================
	     筛选条
	     ============================================ -->
	<ProjectsFilter
		client:only="svelte"
		independentCount={independentCount}
		secondaryCount={secondaryCount}
		totalCount={totalCount}
	/>

	<!-- ============================================
	     空状态
	     ============================================ -->
	{renderedPosts.length === 0 && (
		<div class="projects-empty">
			<p class="projects-empty__text">
				暂无项目收录，去给想要展示的文章设置
				<code>category: 独立项目</code>
				或
				<code>category: 二次开发</code>
				吧。
			</p>
		</div>
	)}

	<!-- ============================================
	     项目卡片网格（限定 2 列）
	     ============================================ -->
	{renderedPosts.length > 0 && (
		<section
			class="projects-grid"
			aria-label="项目列表"
		>
			{renderedPosts.map(({ entry }, i) => {
				const techStack = (entry.data.tags ?? []).slice(0, 4);
				return (
					<ProjectCard
						entry={entry}
						techStack={techStack}
						index={i + 1}
						style={`animation-delay: calc(var(--content-delay) + ${(i + 1) * 60}ms);`}
					/>
				);
			})}
		</section>
	)}
</div>

<style>
	/* ============================================
	   Tokens
	   ============================================ */
	.projects-page {
		--mono:
			"JetBrains Mono Variable", ui-monospace, SFMono-Regular, Menlo, Monaco,
			Consolas, "Liberation Mono", "Courier New", monospace;
		--display: "Syne", "Noto Serif SC", "Source Han Serif SC", serif;
		--accent: var(--primary);
		--blueprint-line: oklch(0.55 0.02 var(--hue) / 0.18);

		/* 金色三阶（深 → 中 → 浅），用于描边、渐变、点缀 */
		--gold-deep: oklch(0.62 0.13 78);
		--gold: oklch(0.78 0.13 85);
		--gold-light: oklch(0.9 0.08 88);

		display: flex;
		flex-direction: column;
		gap: 1.75rem;
	}

	/* ============================================
	   Hero
	   ============================================ */
	.projects-hero {
		position: relative;
		overflow: hidden;
		border-radius: var(--radius-large);
		padding: 4rem 2.5rem 3rem;
		background:
			linear-gradient(
				135deg,
				oklch(0.97 0.015 var(--hue)) 0%,
				oklch(0.94 0.03 calc(var(--hue) + 30)) 60%,
				oklch(0.96 0.045 calc(var(--hue) + 60)) 100%
			);
		box-shadow:
			inset 0 1px 0 0 oklch(0.99 0.01 var(--hue)),
			0 1px 2px 0 rgb(0 0 0 / 0.03);
		animation: projectsHeroIn 0.8s cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	:root.dark .projects-hero {
		background:
			linear-gradient(
				135deg,
				oklch(0.22 0.018 var(--hue)) 0%,
				oklch(0.26 0.035 calc(var(--hue) + 30)) 60%,
				oklch(0.30 0.05 calc(var(--hue) + 60)) 100%
			);
		box-shadow:
			inset 0 1px 0 0 oklch(0.32 0.02 var(--hue)),
			0 4px 20px -4px rgb(0 0 0 / 0.4);
	}

	@keyframes projectsHeroIn {
		from { opacity: 0; transform: translateY(-8px); }
		to { opacity: 1; transform: translateY(0); }
	}

	/* 栅格背景层（双层叠加：24px 细 + 120px 粗） */
	.projects-hero__grid {
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(var(--blueprint-line) 1px, transparent 1px),
			linear-gradient(90deg, var(--blueprint-line) 1px, transparent 1px),
			linear-gradient(oklch(0.5 0.02 var(--hue) / 0.08) 1px, transparent 1px),
			linear-gradient(90deg, oklch(0.5 0.02 var(--hue) / 0.08) 1px, transparent 1px);
		background-size:
			24px 24px,
			24px 24px,
			120px 120px,
			120px 120px;
		background-position: -1px -1px;
		pointer-events: none;
		opacity: 0.85;
	}

	/* 四角 ┌ ┐ └ ┘ 装饰 */
	.projects-hero__corner {
		position: absolute;
		width: 28px;
		height: 28px;
		pointer-events: none;
	}
	.projects-hero__corner::before,
	.projects-hero__corner::after {
		content: "";
		position: absolute;
		background: var(--accent);
	}
	.projects-hero__corner--tl { top: 16px; left: 16px; }
	.projects-hero__corner--tl::before { top: 0; left: 0; width: 100%; height: 2px; }
	.projects-hero__corner--tl::after { top: 0; left: 0; width: 2px; height: 100%; }
	.projects-hero__corner--tr { top: 16px; right: 16px; }
	.projects-hero__corner--tr::before { top: 0; right: 0; width: 100%; height: 2px; }
	.projects-hero__corner--tr::after { top: 0; right: 0; width: 2px; height: 100%; }
	.projects-hero__corner--bl { bottom: 16px; left: 16px; }
	.projects-hero__corner--bl::before { bottom: 0; left: 0; width: 100%; height: 2px; }
	.projects-hero__corner--bl::after { bottom: 0; left: 0; width: 2px; height: 100%; }
	.projects-hero__corner--br { bottom: 16px; right: 16px; }
	.projects-hero__corner--br::before { bottom: 0; right: 0; width: 100%; height: 2px; }
	.projects-hero__corner--br::after { bottom: 0; right: 0; width: 2px; height: 100%; }

	/* ============================================
	   装饰：手绘铅笔（左上 / 右下，金色描边）
	   ============================================ */
	.projects-hero__pencil {
		position: absolute;
		width: 56px;
		height: 56px;
		color: var(--gold-deep);
		opacity: 0.55;
		pointer-events: none;
		z-index: 1;
		transition: opacity 0.5s ease, transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.projects-hero__pencil--tl {
		top: 22px;
		left: 60px;
		transform: rotate(-32deg);
	}

	.projects-hero__pencil--br {
		bottom: 28px;
		right: 60px;
		transform: rotate(148deg);
		color: var(--gold);
		opacity: 0.45;
	}

	.projects-hero:hover .projects-hero__pencil--tl {
		opacity: 0.85;
		transform: rotate(-28deg) translate(-2px, -2px);
	}
	.projects-hero:hover .projects-hero__pencil--br {
		opacity: 0.7;
		transform: rotate(152deg) translate(2px, -2px);
	}

	/* ============================================
	   装饰：金色 ✦ 星点
	   ============================================ */
	.projects-hero__spark {
		position: absolute;
		color: var(--gold);
		pointer-events: none;
		font-family: "Syne", serif;
		font-weight: 700;
		line-height: 1;
		z-index: 1;
	}

	.projects-hero__spark--1 {
		top: 38px;
		right: 130px;
		font-size: 1.5rem;
		opacity: 0.7;
		transform: rotate(15deg);
	}

	.projects-hero__spark--2 {
		bottom: 52px;
		left: 140px;
		font-size: 1.125rem;
		opacity: 0.6;
		transform: rotate(-10deg);
		color: var(--gold-light);
	}

	.projects-hero__spark--3 {
		top: 50%;
		right: 50px;
		font-size: 0.875rem;
		opacity: 0.55;
		transform: translateY(-50%) rotate(20deg);
	}

	.projects-hero__inner {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.5rem;
		text-align: center;
	}

	/* ============================================
	   顶部小帽：手绘双线 + 文本（呼应精选页）
	   ============================================ */
	.projects-hero__eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.875rem;
		font-family: var(--mono);
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.28em;
		text-transform: uppercase;
		color: var(--gold-deep);
	}

	.projects-hero__rule {
		display: inline-block;
		width: 2.25rem;
		height: 1px;
		background: linear-gradient(
			90deg,
			transparent 0%,
			var(--gold-deep) 50%,
			transparent 100%
		);
	}

	/* 手绘金色下划线（铅笔勾线笔触） */
	.projects-hero__underline {
		display: block;
		width: clamp(160px, 18vw, 220px);
		height: 14px;
		color: var(--gold);
		opacity: 0.85;
		margin-top: -0.5rem;
	}

	/* 主标题 */
	.projects-hero__title {
		margin: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		line-height: 1;
	}

	.projects-hero__title-en {
		font-family: var(--display);
		font-size: 1rem;
		font-style: italic;
		font-weight: 600;
		letter-spacing: 0.32em;
		text-transform: uppercase;
		color: var(--accent);
		opacity: 0.75;
	}

	.projects-hero__title-zh {
		font-family: var(--display);
		font-size: clamp(2.5rem, 1.2rem + 5vw, 4.5rem);
		font-weight: 800;
		letter-spacing: 0.12em;
		background: linear-gradient(
			180deg,
			oklch(0.22 0.04 var(--hue)) 0%,
			oklch(0.45 0.1 var(--hue)) 100%
		);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	:root.dark .projects-hero__title-zh {
		background: linear-gradient(
			180deg,
			oklch(0.95 0.02 var(--hue)) 0%,
			oklch(0.7 0.1 var(--hue)) 100%
		);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	/* 副标题 */
	.projects-hero__subtitle {
		margin: 0;
		font-family: var(--mono);
		font-size: 0.8125rem;
		color: oklch(0.5 0.02 var(--hue));
		letter-spacing: 0.05em;
	}

	:root.dark .projects-hero__subtitle {
		color: oklch(0.7 0.015 var(--hue));
	}

	.projects-hero__subtitle-sep {
		opacity: 0.4;
		margin: 0 0.25rem;
	}

	/* 数据条（3 项） */
	.projects-hero__specs {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.625rem 0.875rem;
		margin-top: 1rem;
		padding: 1rem 1.5rem;
		border-top: 1px dashed oklch(0.5 0.02 var(--hue) / 0.3);
		border-bottom: 1px dashed oklch(0.5 0.02 var(--hue) / 0.3);
		font-family: var(--mono);
	}

	.projects-hero__spec {
		display: inline-flex;
		align-items: baseline;
		gap: 0.4375rem;
	}

	.projects-hero__spec-label {
		font-size: 0.625rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		color: oklch(0.55 0.02 var(--hue));
		opacity: 0.75;
	}

	:root.dark .projects-hero__spec-label {
		color: oklch(0.7 0.02 var(--hue));
	}

	.projects-hero__spec-value {
		font-size: 1.0625rem;
		font-weight: 800;
		font-feature-settings: "tnum" 1;
		letter-spacing: 0.04em;
		background: linear-gradient(
			180deg,
			var(--gold-deep) 0%,
			var(--gold) 60%,
			var(--gold-light) 100%
		);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
		color: var(--gold);
	}

	:root.dark .projects-hero__spec-value {
		background: linear-gradient(
			180deg,
			var(--gold) 0%,
			var(--gold-light) 60%,
			oklch(0.95 0.06 90) 100%
		);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.projects-hero__spec-sep {
		color: oklch(0.55 0.02 var(--hue));
		opacity: 0.3;
	}

	/* ============================================
	   空状态
	   ============================================ */
	.projects-empty {
		text-align: center;
		padding: 4rem 1rem;
		color: oklch(0.55 0.02 var(--hue));
		font-size: 0.95rem;
	}

	:root.dark .projects-empty {
		color: oklch(0.7 0.015 var(--hue));
	}

	.projects-empty__text code {
		font-family: var(--mono);
		background: var(--btn-regular-bg);
		padding: 0.1rem 0.4rem;
		border-radius: 4px;
		color: var(--accent);
		font-size: 0.85em;
	}

	/* ============================================
	   网格（限定 2 列）
	   ============================================ */
	.projects-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
	}

	@media (min-width: 768px) {
		.projects-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	/* ============================================
	   移动端
	   ============================================ */
	@media (max-width: 768px) {
		.projects-hero {
			padding: 2.5rem 1.25rem 2rem;
		}
		.projects-hero__corner {
			width: 20px;
			height: 20px;
		}
		.projects-hero__specs {
			gap: 0.375rem 0.625rem;
		}
		.projects-hero__spec-value {
			font-size: 0.9375rem;
		}
		/* 移动端隐藏铅笔/星点装饰，避免拥挤 */
		.projects-hero__pencil,
		.projects-hero__spark {
			display: none;
		}
		.projects-hero__underline {
			width: 140px;
		}
	}
</style>
