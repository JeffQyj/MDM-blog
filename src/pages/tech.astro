---
import TechCanvas from "@components/tech/TechCanvas.svelte";
import TechTooltip from "@components/tech/TechTooltip.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
---

<MainGridLayout
	title={i18n(I18nKey.tech)}
	description="技术神经图谱：罗列我学过与认知到的技术栈"
>
	<div class="tech-page">
		<!-- ============================================
		     Hero 英雄区（神经网 + 星点风格，呼应项目页）
		     ============================================ -->
		<section
			class="tech-hero"
			style="animation-delay: calc(var(--content-delay) + 0ms);"
		>
			<!-- 神经网底层纹理 -->
			<div class="tech-hero__net" aria-hidden="true"></div>
			<div class="tech-hero__stars" aria-hidden="true">
				<span class="tech-hero__star tech-hero__star--1">✦</span>
				<span class="tech-hero__star tech-hero__star--2">✦</span>
				<span class="tech-hero__star tech-hero__star--3">·</span>
				<span class="tech-hero__star tech-hero__star--4">·</span>
				<span class="tech-hero__star tech-hero__star--5">·</span>
				<span class="tech-hero__star tech-hero__star--6">✦</span>
			</div>

			<!-- 四角 ┌ ┐ └ ┘ 装饰 -->
			<span class="tech-hero__corner tech-hero__corner--tl" aria-hidden="true"></span>
			<span class="tech-hero__corner tech-hero__corner--tr" aria-hidden="true"></span>
			<span class="tech-hero__corner tech-hero__corner--bl" aria-hidden="true"></span>
			<span class="tech-hero__corner tech-hero__corner--br" aria-hidden="true"></span>

			<div class="tech-hero__inner">
				<!-- 顶部小帽 -->
				<div class="tech-hero__eyebrow">
					<span class="tech-hero__rule"></span>
					<span class="tech-hero__eyebrow-text">NEURAL · MAP　技　术　星　图</span>
					<span class="tech-hero__rule"></span>
				</div>

				<!-- 主标题 -->
				<h1 class="tech-hero__title">
					<span class="tech-hero__title-en">Tech</span>
					<span class="tech-hero__title-zh">技　术</span>
				</h1>

				<!-- 副标题 -->
				<p class="tech-hero__subtitle">
					欢迎探索我的技术宇宙
				</p>
			</div>
		</section>

		<!-- ============================================
		     主舞台：画布 + Tooltip 浮层
		     Tooltip 需放在 canvas 同级，以便 absolute 定位
		     ============================================ -->
		<div class="tech-stage">
			<TechCanvas client:only="svelte" />
			<TechTooltip client:only="svelte" />
		</div>
	</div>
</MainGridLayout>

<style>
	/* ============================================
	   Tokens
	   ============================================ */
	.tech-page {
		--mono:
			"JetBrains Mono Variable", ui-monospace, SFMono-Regular, Menlo, Monaco,
			Consolas, "Liberation Mono", "Courier New", monospace;
		--display: "Syne", "Noto Serif SC", "Source Han Serif SC", serif;
		--accent: var(--primary);
		--gold-deep: oklch(0.62 0.13 78);
		--gold: oklch(0.78 0.13 85);
		--gold-light: oklch(0.9 0.08 88);
		--blue: oklch(0.7 0.12 230);

		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	/* ============================================
	   Hero
	   ============================================ */
	.tech-hero {
		position: relative;
		overflow: hidden;
		border-radius: var(--radius-large);
		padding: 3rem 2rem 2.25rem;
		background:
			radial-gradient(
				ellipse at 30% 30%,
				oklch(0.26 0.04 var(--hue)) 0%,
				oklch(0.18 0.025 var(--hue)) 60%,
				oklch(0.14 0.018 var(--hue)) 100%
			);
		box-shadow:
			inset 0 1px 0 0 oklch(0.32 0.02 var(--hue) / 0.6),
			0 4px 20px -4px rgb(0 0 0 / 0.4);
		animation: techHeroIn 0.8s cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	@keyframes techHeroIn {
		from {
			opacity: 0;
			transform: translateY(-8px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	/* 神经网底层纹理（双层点阵 + 微弱连线） */
	.tech-hero__net {
		position: absolute;
		inset: 0;
		pointer-events: none;
		opacity: 0.55;
		background-image:
			radial-gradient(
				oklch(0.92 0.01 var(--hue) / 0.22) 1px,
				transparent 1px
			),
			radial-gradient(
				oklch(0.78 0.13 85 / 0.18) 1px,
				transparent 1px
			);
		background-size: 28px 28px, 84px 84px;
		background-position: 0 0, 14px 14px;
		mask-image: radial-gradient(
			ellipse at center,
			rgb(0 0 0) 30%,
			transparent 80%
		);
		-webkit-mask-image: radial-gradient(
			ellipse at center,
			rgb(0 0 0) 30%,
			transparent 80%
		);
	}

	/* 星点装饰 */
	.tech-hero__stars {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.tech-hero__star {
		position: absolute;
		font-family: "Syne", serif;
		font-weight: 700;
		color: var(--gold);
		opacity: 0.7;
		line-height: 1;
	}

	.tech-hero__star--1 {
		top: 28px;
		left: 12%;
		font-size: 1.25rem;
		transform: rotate(15deg);
	}
	.tech-hero__star--2 {
		top: 50%;
		right: 8%;
		font-size: 1rem;
		opacity: 0.5;
		transform: translateY(-50%) rotate(-10deg);
		color: var(--gold-light);
	}
	.tech-hero__star--3 {
		bottom: 60px;
		left: 18%;
		font-size: 1.5rem;
		opacity: 0.6;
		color: oklch(0.92 0.02 var(--hue));
	}
	.tech-hero__star--4 {
		top: 80px;
		right: 24%;
		font-size: 0.875rem;
		opacity: 0.45;
		color: var(--blue);
	}
	.tech-hero__star--5 {
		bottom: 30px;
		right: 32%;
		font-size: 0.75rem;
		opacity: 0.55;
		color: oklch(0.92 0.02 var(--hue));
	}
	.tech-hero__star--6 {
		top: 45%;
		left: 6%;
		font-size: 1.125rem;
		opacity: 0.6;
		color: var(--gold-deep);
	}

	/* 四角 ┌ ┐ └ ┘ 装饰 */
	.tech-hero__corner {
		position: absolute;
		width: 24px;
		height: 24px;
		pointer-events: none;
	}
	.tech-hero__corner::before,
	.tech-hero__corner::after {
		content: "";
		position: absolute;
		background: var(--accent);
		opacity: 0.6;
	}
	.tech-hero__corner--tl { top: 14px; left: 14px; }
	.tech-hero__corner--tl::before { top: 0; left: 0; width: 100%; height: 1.5px; }
	.tech-hero__corner--tl::after { top: 0; left: 0; width: 1.5px; height: 100%; }
	.tech-hero__corner--tr { top: 14px; right: 14px; }
	.tech-hero__corner--tr::before { top: 0; right: 0; width: 100%; height: 1.5px; }
	.tech-hero__corner--tr::after { top: 0; right: 0; width: 1.5px; height: 100%; }
	.tech-hero__corner--bl { bottom: 14px; left: 14px; }
	.tech-hero__corner--bl::before { bottom: 0; left: 0; width: 100%; height: 1.5px; }
	.tech-hero__corner--bl::after { bottom: 0; left: 0; width: 1.5px; height: 100%; }
	.tech-hero__corner--br { bottom: 14px; right: 14px; }
	.tech-hero__corner--br::before { bottom: 0; right: 0; width: 100%; height: 1.5px; }
	.tech-hero__corner--br::after { bottom: 0; right: 0; width: 1.5px; height: 100%; }

	.tech-hero__inner {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.125rem;
		text-align: center;
	}

	/* 顶部小帽 */
	.tech-hero__eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.875rem;
		font-family: var(--mono);
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.28em;
		text-transform: uppercase;
		color: var(--gold);
	}

	.tech-hero__rule {
		display: inline-block;
		width: 2rem;
		height: 1px;
		background: linear-gradient(
			90deg,
			transparent 0%,
			var(--gold) 50%,
			transparent 100%
		);
	}

	/* 主标题 */
	.tech-hero__title {
		margin: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		line-height: 1;
	}

	.tech-hero__title-en {
		font-family: var(--display);
		font-size: 1rem;
		font-style: italic;
		font-weight: 600;
		letter-spacing: 0.32em;
		text-transform: uppercase;
		color: var(--accent);
		opacity: 0.85;
	}

	.tech-hero__title-zh {
		font-family: var(--display);
		font-size: clamp(2.5rem, 1.2rem + 5vw, 4.5rem);
		font-weight: 800;
		letter-spacing: 0.12em;
		background: linear-gradient(
			180deg,
			oklch(0.98 0.01 var(--hue)) 0%,
			oklch(0.78 0.13 85) 100%
		);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	/* 副标题 */
	.tech-hero__subtitle {
		margin: 0;
		font-family: var(--mono);
		font-size: 0.8125rem;
		color: oklch(0.78 0.01 var(--hue));
		letter-spacing: 0.05em;
	}

	.tech-hero__subtitle-sep {
		opacity: 0.4;
		margin: 0 0.25rem;
	}

	/* 操作提示 */
	.tech-hero__hint {
		margin: 0;
		font-family: var(--mono);
		font-size: 0.6875rem;
		letter-spacing: 0.18em;
		color: oklch(0.65 0.01 var(--hue));
		opacity: 0.7;
		padding-top: 0.5rem;
	}

	/* ============================================
	   主舞台
	   ============================================ */
	.tech-stage {
		position: relative;
		border-radius: var(--radius-large);
		overflow: hidden;
	}

	/* ============================================
	   移动端
	   ============================================ */
	@media (max-width: 768px) {
		.tech-hero {
			padding: 2rem 1.25rem 1.5rem;
		}
		.tech-hero__corner {
			width: 18px;
			height: 18px;
		}
		.tech-hero__star--2,
		.tech-hero__star--4,
		.tech-hero__star--5,
		.tech-hero__star--6 {
			display: none;
		}
		.tech-hero__hint {
			font-size: 0.625rem;
			letter-spacing: 0.12em;
		}
	}
</style>
